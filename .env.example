# Existing OpenAI-compatible provider (e.g. Volcengine Ark); do not commit real keys.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
MODEL_NAME=your-tool-calling-model-endpoint
MODEL_TIMEOUT=60
MODEL_MAX_RETRIES=2
AGENT_MAX_ITERATIONS=4
CHAT_TIMEOUT=180

# postgres for persistent sessions; memory for local development (lost on restart).
CHECKPOINT_BACKEND=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=agent_db
POSTGRES_SSLMODE=prefer

DOCS_DIR=data/docs
PERSIST_DB_DIR=data/chroma_db
CHROMA_COLLECTION=langchain
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-large
EMBEDDING_DEVICE=cpu
RETRIEVAL_TOP_K=10
RETRIEVAL_TOP_N=3
CORS_ORIGINS=["http://localhost:3000"]
